# 依赖与构建产物不入库
node_modules/
dist/

# Android 构建缓存与产物（工程源码 android/ 要入库，便于复现构建；这些是缓存和打包结果）
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
*.apk
*.aab
*.keystore
!debug.keystore

# 账号数据库（含密码哈希与会话，绝不能入库）
*.db
*.db-wal
*.db-shm

# AI 第三方 API Key（智谱 GLM），只存在服务器，绝不能进公开仓库
server/ai.key.js
server-remote/ai.key.js
server/*.key.js
server-remote/*.key.js

# 包管理器锁文件（可选，若希望锁定版本可保留 package-lock.json）
npm-debug.log*

# 编辑器 / 系统文件
.DS_Store
Thumbs.db
*.local

# 服务端运行期数据（绝不能入库）：管理员密钥 data/admin-token.txt、玩家账号库、
# 地图/商店/建造/兑换码数据。server-remote/data/.gitkeep 例外保留（占位用）。
server-remote/data/*
!server-remote/data/.gitkeep
server/data/*
!server/data/.gitkeep

# 工具跑出的临时产物（esbuild 输出 / 临时场景抓取 / 临时目录），非源码，绝不入库
_esb_main.out.js
_esb_*.out.js
_perftmp/
_tmp_remote_scene.json
_tmp_*.json