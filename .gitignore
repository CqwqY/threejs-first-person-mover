# 依赖与构建产物不入库
node_modules/
dist/

# 账号数据库（含密码哈希与会话，绝不能入库）
*.db
*.db-wal
*.db-shm

# AI 第三方 API Key（智谱 GLM），只存在服务器，绝不能进公开仓库
server/ai.key.js
server-remote/ai.key.js
server/*.key.js
server-remote/*.key.js

# 包管理器锁文件（可选，若希望锁定版本可保留 package-lock.json）
npm-debug.log*

# 编辑器 / 系统文件
.DS_Store
Thumbs.db
*.local